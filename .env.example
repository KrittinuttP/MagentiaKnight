NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required to unlock /admin (no default — admin stays locked if unset)
SITE_ADMIN_PASSWORD=choose-a-team-password
# Optional HMAC secret for the admin cookie (falls back to service role key)
SITE_ADMIN_SECRET=your-random-secret-string
